# =========================================================
# APPLICATION
# =========================================================

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

APP_NAME=echogpt-backend
APP_BASE_URL=http://localhost:3000

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=debug

THROTTLE_TTL=60000
THROTTLE_LIMIT=100


# =========================================================
# DATABASE 
# =========================================================

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.REGION.aws.neon.tech/neondb?sslmode=require"


# =========================================================
# JWT AUTHENTICATION 
# =========================================================

JWT_ACCESS_SECRET= openssl rand -base64 48 (on bash)
JWT_REFRESH_SECRET= openssl rand -base64 48 (on bash)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800


# =========================================================
# PROVIDER ENCRYPTION 
# =========================================================

# PROVIDER_ENCRYPTION_KEY=


